<?xml version="1.0" encoding="UTF-8"?>
<!--
  The concurrency suite (tests/Concurrency): real parallel HTTP against a running,
  multi-threaded server. Run with `composer test:concurrency` (bin/test-concurrency),
  which starts that server on the same schema. Never with parallel Pest.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Shared with the server (bin/test-concurrency exports the same name to both). -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="reservevision_concurrency"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DB_MIGRATOR_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
