#!/usr/bin/env bash
# One command from a clean clone to a running dev stack.
# Non-interactive and idempotent: safe to run again at any time.
#
#   bin/setup            build, install, migrate, seed, start
#
# Two modes:
# - On the host (default): needs only Docker with Compose v2; drives `docker compose`.
# - Inside the dev container (RV_DEVCONTAINER=1, set by .devcontainer/compose.devcontainer.yaml):
#   the devcontainer has already started the stack, so this runs the same steps
#   directly in the workspace (`app`) container, and builds the assets instead
#   of relying on the Vite dev server.
set -euo pipefail

cd "$(dirname "$0")/.."

step() { printf '\n\033[1;35m==> %s\033[0m\n' "$*"; }

# Waits until the page at $1 is server-rendered (an <h1> in the raw HTML), not just a 200:
# right after the ssr service starts, Inertia falls back to client rendering.
wait_for_ssr() {
    local url="$1"
    step "Waiting for the home page to be server-rendered"
    for _ in $(seq 1 60); do
        if curl -fsS "$url" 2>/dev/null | grep -q '<h1'; then
            return 0
        fi
        sleep 2
    done
    echo "The home page was not server-rendered at ${url} (check the ssr service logs)" >&2
    return 1
}

if [[ "${RV_DEVCONTAINER:-}" == 1 ]]; then
    step "Environment file"
    [[ -f .env ]] || cp .env.example .env
    if [[ "${CODESPACES:-}" == true ]]; then
        # Absolute URLs (redirects, mail links) must use the forwarded address.
        app_url="https://${CODESPACE_NAME}-8000.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}"
    else
        app_url="http://localhost:8000"
    fi
    sed -i "s|^APP_URL=.*|APP_URL=${app_url}|" .env
    echo "APP_URL=${app_url}"

    step "Installing PHP dependencies"
    composer install --no-interaction --prefer-dist --no-progress

    step "Installing JavaScript dependencies"
    npm ci --no-audit --no-fund

    step "Building the client and SSR bundles"
    # A stale public/hot would point the app at a Vite dev server that isn't running here.
    rm -f public/hot
    npm run build

    if ! grep -qE '^APP_KEY=.+' .env; then
        step "Generating the application key"
        php artisan key:generate --force --no-interaction
    fi

    step "Migrating (as migrator) and seeding (as app)"
    php artisan migrate --database=mysql_migrator --force --no-interaction
    php artisan db:seed --force --no-interaction

    wait_for_ssr "http://localhost:8000/"
    echo "ReserveVision is running: open the forwarded port 8000 (Ports tab) or ${app_url}"
    exit 0
fi

compose() { docker compose "$@"; }
# One-off commands in the app image, without starting the stack.
run_app() { compose run --rm --no-deps -T app "$@"; }

step "Environment file"
if [[ ! -f .env ]]; then
    cp .env.example .env
    echo "Created .env from .env.example"
else
    echo ".env already exists; leaving it as is"
fi

step "Building the app image"
compose build --quiet app

step "Installing PHP dependencies"
run_app composer install --no-interaction --prefer-dist --no-progress

step "Installing JavaScript dependencies"
compose run --rm --no-deps -T ssr npm ci --no-audit --no-fund

if ! grep -qE '^APP_KEY=.+' .env; then
    step "Generating the application key"
    run_app php artisan key:generate --force --no-interaction
fi

step "Starting the database"
compose up -d --wait db

# The init script creates the schemas only on an empty volume; volumes from
# before slice 2.5 lack the concurrency suite's schema. Idempotent.
step "Making sure the concurrency suite's schema exists"
concurrency_db="$(grep -E '^DB_CONCURRENCY_DATABASE=' .env | cut -d= -f2 || true)"
concurrency_db="${concurrency_db:-reservevision_concurrency}"
# Runs inside the db container with its own passwords (single quotes on purpose).
# shellcheck disable=SC2016
compose exec -T db sh -c '{
    printf "SET @db_name = '"'"'%s'"'"', @app_password = '"'"'%s'"'"', @migrator_password = '"'"'%s'"'"';\n" \
        "$1" "$RV_DB_APP_PASSWORD" "$RV_DB_MIGRATOR_PASSWORD"
    cat /rv-sql/create-users.sql
} | mysql -u root -p"$MYSQL_ROOT_PASSWORD" 2> /dev/null' sh "$concurrency_db"
echo "${concurrency_db} is ready"

# Before the rest of the stack: the queue worker needs the cache and jobs tables.
step "Migrating (as migrator) and seeding (as app)"
run_app php artisan migrate --database=mysql_migrator --force --no-interaction
run_app php artisan db:seed --force --no-interaction

step "Starting the stack"
compose up -d --wait

app_port="$(grep -E '^APP_PORT=' .env | cut -d= -f2)"
app_port="${app_port:-8180}"

if wait_for_ssr "http://localhost:${app_port}/"; then
    echo "ReserveVision is running at http://localhost:${app_port}"
    exit 0
fi
compose ps >&2
exit 1
