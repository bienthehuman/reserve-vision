#!/usr/bin/env bash
# One command from a clean clone to a running dev stack.
# Non-interactive and idempotent: safe to run again at any time (Codespaces reuses it in 1.3).
#
#   bin/setup            build, install, migrate, seed, start
#
# Needs only Docker with Compose v2 on the host.
set -euo pipefail

cd "$(dirname "$0")/.."

step() { printf '\n\033[1;35m==> %s\033[0m\n' "$*"; }

compose() { docker compose "$@"; }
# One-off commands in the app image, without starting the stack.
run_app() { compose run --rm --no-deps -T app "$@"; }

step "Environment file"
if [[ ! -f .env ]]; then
    cp .env.example .env
    echo "Created .env from .env.example"
else
    echo ".env already exists; leaving it as is"
fi

step "Building the app image"
compose build --quiet app

step "Installing PHP dependencies"
run_app composer install --no-interaction --prefer-dist --no-progress

step "Installing JavaScript dependencies"
compose run --rm --no-deps -T ssr npm ci --no-audit --no-fund

if ! grep -qE '^APP_KEY=.+' .env; then
    step "Generating the application key"
    run_app php artisan key:generate --force --no-interaction
fi

step "Starting the database"
compose up -d --wait db

# Before the rest of the stack: the queue worker needs the cache and jobs tables.
step "Migrating (as migrator) and seeding (as app)"
run_app php artisan migrate --database=mysql_migrator --force --no-interaction
run_app php artisan db:seed --force --no-interaction

step "Starting the stack"
compose up -d --wait

app_port="$(grep -E '^APP_PORT=' .env | cut -d= -f2)"
app_port="${app_port:-8180}"

step "Waiting for the home page to be server-rendered"
# Ready means SSR works, not just HTTP 200: right after the ssr service starts,
# Inertia falls back to client rendering until Vite's SSR module graph is warm.
for _ in $(seq 1 60); do
    if curl -fsS "http://localhost:${app_port}/" 2>/dev/null | grep -q '<h1'; then
        echo "ReserveVision is running at http://localhost:${app_port}"
        exit 0
    fi
    sleep 2
done

echo "The home page was not server-rendered at http://localhost:${app_port}/ (check: docker compose logs ssr)" >&2
compose ps >&2
exit 1
