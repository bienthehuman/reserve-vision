#!/usr/bin/env bash
# Smoke test of a running production stack over HTTP (ADR 0007). Black box: only
# curl against Caddy. Used by .github/workflows/production.yml.
#
#   bin/smoke-production http://localhost:8280
set -euo pipefail

base="${1:?usage: bin/smoke-production <base-url>}"
base="${base%/}"
failures=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

pass() { printf '  \033[32mpass\033[0m  %s\n' "$*"; }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; failures=$((failures + 1)); }

# fetch <path>: body to $tmp/body, headers to $tmp/headers, prints the status code.
fetch() {
    curl -sS -o "$tmp/body" -D "$tmp/headers" -w '%{http_code}' "${base}$1"
}

expect_status() {
    local path="$1" want="$2" got
    got="$(fetch "$path")"
    if [[ "$got" == "$want" ]]; then pass "GET $path is $want"; else fail "GET $path is $got, expected $want"; fi
}

expect_body() {
    if grep -qF -- "$2" "$tmp/body"; then pass "$1"; else fail "$1 (missing: $2)"; fi
}

expect_header() {
    local name="$1" want="$2" line
    line="$(grep -i "^${name}:" "$tmp/headers" | tail -n1 | tr -d '\r' || true)"
    if [[ -n "$line" && "$line" == *"$want"* ]]; then
        pass "$name: ${line#*: }"
    else
        fail "header $name should contain '$want' (got: ${line:-nothing})"
    fi
}

echo "Smoke test against $base"

echo "Home page (server-rendered)"
expect_status / 200
expect_body "the pitch is in the raw HTML" "Reserve apartments and boarding-house beds online, with no double bookings."
expect_body "the page was rendered by the SSR server" 'data-server-rendered="true"'
expect_body "built assets, not the Vite dev server" '/build/assets/app-'

echo "Security headers on /"
expect_header Strict-Transport-Security "max-age=31536000"
expect_header Content-Security-Policy "default-src 'self'"
expect_header Content-Security-Policy "upgrade-insecure-requests"
expect_header X-Frame-Options DENY
expect_header X-Content-Type-Options nosniff
expect_header Referrer-Policy strict-origin-when-cross-origin
expect_header Permissions-Policy "camera=()"
if grep -qi '^Server:' "$tmp/headers"; then fail "a Server header is sent"; else pass "no Server header"; fi

echo "Health and dev-only pages"
expect_status /up 200
expect_status /styleguide 404

echo "Login page (server-rendered) and session cookie"
expect_status /login 200
expect_body "the login form is in the raw HTML" 'name="password"'
expect_body "the login page was rendered by the SSR server" 'data-server-rendered="true"'
session_line="$(grep -i '^Set-Cookie: [a-z0-9_-]*session=' "$tmp/headers" | tail -n1 | tr -d '\r' || true)"
for attribute in secure httponly 'samesite=lax'; do
    if [[ "${session_line,,}" == *"; ${attribute}"* ]]; then
        pass "session cookie is ${attribute}"
    else
        fail "session cookie should be ${attribute} (got: ${session_line:-no session cookie})"
    fi
done

# Log in as the demo owner (CI seeds demo data with APP_DEMO=true). Cookies are passed by hand,
# not through a cookie jar, so the Secure flag over plain-HTTP localhost doesn't matter.
echo "Login as a demo user"
cookies() { grep -i '^Set-Cookie:' "$tmp/headers" | sed -E 's/^[^:]*: *([^;]*).*/\1/' | tr -d '\r' | paste -sd ';' -; }
cookie_header="$(cookies)"
xsrf="$(printf '%s' "$cookie_header" | tr ';' '\n' | sed -n 's/^ *XSRF-TOKEN=//p')"
xsrf="$(printf '%b' "${xsrf//%/\\x}")" # URL-decode
status="$(curl -sS -o "$tmp/body" -D "$tmp/headers" -w '%{http_code}' \
    -H "Cookie: ${cookie_header}" -H "X-XSRF-TOKEN: ${xsrf}" \
    --data-urlencode 'email=owner@example.com' --data-urlencode 'password=password' \
    "${base}/login")"
location="$(grep -i '^Location:' "$tmp/headers" | tail -n1 | tr -d '\r' || true)"
if [[ "$status" == 302 && "$location" == */landlord ]]; then
    pass "POST /login with the CSRF token redirects to /landlord"
else
    fail "POST /login is $status (${location:-no Location}), expected 302 to /landlord"
fi
cookie_header="$(cookies)"
status="$(curl -sS -o "$tmp/body" -D "$tmp/headers" -w '%{http_code}' -H "Cookie: ${cookie_header}" "${base}/landlord")"
if [[ "$status" == 200 ]]; then pass "GET /landlord as the owner is 200"; else fail "GET /landlord as the owner is $status, expected 200"; fi
expect_body "the dashboard shows the owner's account" "Santos Family Rentals"

# TODO(slice 5.1): smoke a public listing page (200, listing title in the raw HTML).

if [[ "$failures" -gt 0 ]]; then
    echo "$failures smoke check(s) failed." >&2
    exit 1
fi
echo "All smoke checks passed."
