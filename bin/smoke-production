#!/usr/bin/env bash
# Smoke test of a running production stack over HTTP (ADR 0007). Black box: only
# curl against Caddy. Used by .github/workflows/production.yml.
#
#   bin/smoke-production http://localhost:8280
set -euo pipefail

base="${1:?usage: bin/smoke-production <base-url>}"
base="${base%/}"
failures=0
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

pass() { printf '  \033[32mpass\033[0m  %s\n' "$*"; }
fail() { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; failures=$((failures + 1)); }

# fetch <path>: body to $tmp/body, headers to $tmp/headers, prints the status code.
fetch() {
    curl -sS -o "$tmp/body" -D "$tmp/headers" -w '%{http_code}' "${base}$1"
}

expect_status() {
    local path="$1" want="$2" got
    got="$(fetch "$path")"
    if [[ "$got" == "$want" ]]; then pass "GET $path is $want"; else fail "GET $path is $got, expected $want"; fi
}

expect_body() {
    if grep -qF -- "$2" "$tmp/body"; then pass "$1"; else fail "$1 (missing: $2)"; fi
}

expect_header() {
    local name="$1" want="$2" line
    line="$(grep -i "^${name}:" "$tmp/headers" | tail -n1 | tr -d '\r' || true)"
    if [[ -n "$line" && "$line" == *"$want"* ]]; then
        pass "$name: ${line#*: }"
    else
        fail "header $name should contain '$want' (got: ${line:-nothing})"
    fi
}

echo "Smoke test against $base"

echo "Home page (server-rendered)"
expect_status / 200
expect_body "the pitch is in the raw HTML" "Reserve apartments and boarding-house beds online, with no double bookings."
expect_body "the page was rendered by the SSR server" 'data-server-rendered="true"'
expect_body "built assets, not the Vite dev server" '/build/assets/app-'

echo "Built assets are cached for good (slice 7.2)"
home_assets="$(grep -o '/build/assets/[A-Za-z0-9._-]*\.\(js\|css\|woff2\)' "$tmp/body" | sort -u)"
test -n "$home_assets" || fail "no /build/assets files linked from /"
for asset in $home_assets; do
    fetch "$asset" >/dev/null
    expect_header Cache-Control "immutable"
done
fetch / >/dev/null

echo "Security headers on /"
expect_header Strict-Transport-Security "max-age=31536000"
expect_header Content-Security-Policy "default-src 'self'"
# upgrade-insecure-requests is sent on HTTPS requests only (SecurityHeaders); this stack may be plain HTTP.
if [[ "$base" == https://* ]]; then expect_header Content-Security-Policy "upgrade-insecure-requests"; fi
expect_header X-Frame-Options DENY
expect_header X-Content-Type-Options nosniff
expect_header Referrer-Policy strict-origin-when-cross-origin
expect_header Permissions-Policy "camera=()"
if grep -qi '^Server:' "$tmp/headers"; then fail "a Server header is sent"; else pass "no Server header"; fi

echo "Health and dev-only pages"
expect_status /up 200
expect_status /styleguide 404

echo "Login page (server-rendered) and session cookie"
expect_status /login 200
expect_body "the login form is in the raw HTML" 'name="password"'
expect_body "the login page was rendered by the SSR server" 'data-server-rendered="true"'
session_line="$(grep -i '^Set-Cookie: [a-z0-9_-]*session=' "$tmp/headers" | tail -n1 | tr -d '\r' || true)"
for attribute in secure httponly 'samesite=lax'; do
    if [[ "${session_line,,}" == *"; ${attribute}"* ]]; then
        pass "session cookie is ${attribute}"
    else
        fail "session cookie should be ${attribute} (got: ${session_line:-no session cookie})"
    fi
done

# Log in as the demo owner (CI seeds demo data with APP_DEMO=true). Cookies are passed by hand,
# not through a cookie jar, so the Secure flag over plain-HTTP localhost doesn't matter.
echo "Login as a demo user"
cookies() { grep -i '^Set-Cookie:' "$tmp/headers" | sed -E 's/^[^:]*: *([^;]*).*/\1/' | tr -d '\r' | paste -sd ';' -; }
cookie_header="$(cookies)"
xsrf="$(printf '%s' "$cookie_header" | tr ';' '\n' | sed -n 's/^ *XSRF-TOKEN=//p')"
xsrf="$(printf '%b' "${xsrf//%/\\x}")" # URL-decode
status="$(curl -sS -o "$tmp/body" -D "$tmp/headers" -w '%{http_code}' \
    -H "Cookie: ${cookie_header}" -H "X-XSRF-TOKEN: ${xsrf}" \
    --data-urlencode 'email=owner@example.com' --data-urlencode 'password=password' \
    "${base}/login")"
location="$(grep -i '^Location:' "$tmp/headers" | tail -n1 | tr -d '\r' || true)"
if [[ "$status" == 302 && "$location" == */landlord ]]; then
    pass "POST /login with the CSRF token redirects to /landlord"
else
    fail "POST /login is $status (${location:-no Location}), expected 302 to /landlord"
fi
cookie_header="$(cookies)"
status="$(curl -sS -o "$tmp/body" -D "$tmp/headers" -w '%{http_code}' -H "Cookie: ${cookie_header}" "${base}/landlord")"
if [[ "$status" == 200 ]]; then pass "GET /landlord as the owner is 200"; else fail "GET /landlord as the owner is $status, expected 200"; fi
expect_body "the dashboard shows the owner's account" "Santos Family Rentals"

# Isolation (slice 3.2): another account's reservation is a 404, and the owner's own is not.
# CI passes the id of one of owner@example.com's reservations, read from the seeded data (never hard-coded).
if [[ -n "${SMOKE_OWNER_RESERVATION_ID:-}" ]]; then
    echo "Isolation: owner2 and the owner's reservation ${SMOKE_OWNER_RESERVATION_ID}"
    reservation_path="/landlord/reservations/${SMOKE_OWNER_RESERVATION_ID}"
    status="$(curl -sS -o "$tmp/body" -D "$tmp/headers" -w '%{http_code}' -H "Cookie: ${cookie_header}" "${base}${reservation_path}")"
    if [[ "$status" == 200 ]]; then pass "GET ${reservation_path} as the owner is 200"; else fail "GET ${reservation_path} as the owner is $status, expected 200"; fi

    curl -sS -o "$tmp/body" -D "$tmp/headers" "${base}/login"
    cookie_header="$(cookies)"
    xsrf="$(printf '%s' "$cookie_header" | tr ';' '\n' | sed -n 's/^ *XSRF-TOKEN=//p')"
    xsrf="$(printf '%b' "${xsrf//%/\\x}")"
    curl -sS -o "$tmp/body" -D "$tmp/headers" \
        -H "Cookie: ${cookie_header}" -H "X-XSRF-TOKEN: ${xsrf}" \
        --data-urlencode 'email=owner2@example.com' --data-urlencode 'password=password' \
        "${base}/login"
    cookie_header="$(cookies)"
    status="$(curl -sS -o "$tmp/body" -D "$tmp/headers" -w '%{http_code}' -H "Cookie: ${cookie_header}" "${base}/landlord")"
    if [[ "$status" == 200 ]]; then pass "GET /landlord as owner2 is 200"; else fail "GET /landlord as owner2 is $status, expected 200 (login failed?)"; fi
    status="$(curl -sS -o "$tmp/body" -D "$tmp/headers" -w '%{http_code}' -H "Cookie: ${cookie_header}" "${base}${reservation_path}")"
    if [[ "$status" == 404 ]]; then pass "GET ${reservation_path} as owner2 is 404"; else fail "GET ${reservation_path} as owner2 is $status, expected 404"; fi
    if grep -qF -- "Santos" "$tmp/body"; then fail "the 404 for owner2 mentions the other account"; else pass "the 404 shows nothing of the other account"; fi
else
    echo "Isolation check skipped: SMOKE_OWNER_RESERVATION_ID is not set."
fi

# A public listing page (slice 5.1), from the demo data: the "last bed" house. Server-rendered, with its sharing tags,
# and listed in the sitemap; robots.txt points to the sitemap and keeps crawlers out of the private pages.
listing_path="/listings/manila/santos-bedspace-house"
echo "Listing page ${listing_path}"
status="$(fetch "$listing_path")"
if [[ "$status" == 200 ]]; then pass "GET ${listing_path} is 200"; else fail "GET ${listing_path} is $status, expected 200"; fi
expect_body "the title is in the raw HTML" "Santos Bedspace House · Rooms from"
expect_body "the page was rendered by the SSR server" 'data-server-rendered="true"'
expect_body "the canonical link is in the raw HTML" 'rel="canonical"'
expect_body "the Open Graph image is in the raw HTML" 'property="og:image"'
expect_body "the JSON-LD block is in the raw HTML" 'type="application/ld+json"'
expect_body "a room's reserve form posts with a token" 'name="_token"'
if [[ "$(grep -c 'rel="canonical"' "$tmp/body")" == 1 ]]; then pass "the canonical link is there once"; else fail "the canonical link should appear once"; fi
expect_status /rooms/1 301
expect_header Location "$listing_path"

status="$(fetch /sitemap.xml)"
if [[ "$status" == 200 ]]; then pass "GET /sitemap.xml is 200"; else fail "GET /sitemap.xml is $status, expected 200"; fi
expect_body "the sitemap lists the listing" "$listing_path"
status="$(fetch /robots.txt)"
if [[ "$status" == 200 ]]; then pass "GET /robots.txt is 200"; else fail "GET /robots.txt is $status, expected 200"; fi
expect_body "robots.txt points to the sitemap" "Sitemap: "
expect_body "robots.txt keeps crawlers out of /landlord" "Disallow: /landlord"
expect_status /listings/manila/not-a-listing 404

# Search (slice 5.2): a demo city's results are in the raw HTML (server-rendered, no JavaScript needed), and the
# filter form is a plain GET form.
echo "Search /listings?city=manila"
status="$(fetch "/listings?city=manila&max_price=30000")"
if [[ "$status" == 200 ]]; then pass "GET /listings?city=manila is 200"; else fail "GET /listings?city=manila is $status, expected 200"; fi
expect_body "the results are server-rendered" 'data-server-rendered="true"'
expect_body "a result card is in the raw HTML" 'class="listing-card'
expect_body "a Manila result is in the raw HTML" 'Manila'
expect_body "the filters are a plain GET form" 'action="/listings"'
expect_status "/listings?city=not-a-city&min_price=abc&move_in=1999-01-01" 200

if [[ "$failures" -gt 0 ]]; then
    echo "$failures smoke check(s) failed." >&2
    exit 1
fi
echo "All smoke checks passed."
