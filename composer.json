{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bienthehuman/reserve-vision",
    "type": "project",
    "description": "Multi-landlord reservations for apartments and boarding-house beds.",
    "keywords": [
        "laravel",
        "inertia",
        "reservations"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "fakerphp/faker": "^1.23",
        "inertiajs/inertia-laravel": "^3.7",
        "laravel/fortify": "^1.42",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.32"
    },
    "require-dev": {
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "conflict": {
        "brianium/paratest": ">=7.28"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": [
            "@php artisan migrate --database=mysql_migrator --force --ansi"
        ],
        "lint": [
            "pint --test"
        ],
        "format": [
            "pint"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/pest"
        ],
        "test:concurrency": [
            "Composer\\Config::disableProcessTimeout",
            "bin/test-concurrency"
        ],
        "pre-autoload-dump": [
            "Aws\\Script\\Composer\\Composer::removeUnusedServices"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "aws/aws-sdk-php": [
            "S3"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "process-timeout": 0
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "migrate": "Run migrations as the migrator DB user (ADR 0008).",
        "lint": "Check code style with Pint.",
        "format": "Fix code style with Pint.",
        "analyse": "Larastan at max level.",
        "test": "Pest, as the app DB user, against the test schema."
    }
}
