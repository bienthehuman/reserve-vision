# Production environment for compose.prod.yaml and deploy.sh (DEPLOY.md).
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Then fill in every empty value. .env.production is git-ignored and never goes
# into the image (.dockerignore). It is read twice: by Compose for ${…} in
# compose.prod.yaml (--env-file), and by the app, worker and scheduler
# containers as their environment (env_file).
#
# Generate strong secrets with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- Host and HTTPS (Caddy) -------------------------------------------------
# The public host name. Its DNS A/AAAA record must point at this server before
# the first start: Caddy then gets a certificate automatically. `:80` serves
# plain HTTP without certificates (CI and local trial runs only).
DOMAIN=
# Contact address for the certificate authority (expiry and problem notices).
ACME_EMAIL=
# Host ports Caddy listens on. Keep 80/443 in production.
HTTP_PORT=80
HTTPS_PORT=443
# Image tag; deploy.sh sets it to the git tag being deployed.
IMAGE_TAG=latest

# --- Laravel ----------------------------------------------------------------
APP_NAME=ReserveVision
APP_ENV=production
# Generate once and keep it: changing it logs everyone out and breaks encrypted data.
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
# https://<DOMAIN>, no trailing slash.
APP_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

# Seeds fake landlords, listings and reservations (php artisan db:seed). Leave false on a real site.
APP_DEMO=false
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs go to the container output: `docker compose -f compose.prod.yaml logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (MySQL 8.4, ADR 0008) -----------------------------------------
# The db container creates the schema and both users from these values on its
# first start (database/sql/create-users.sql). Changing them later needs the
# SQL file run again as root; see DEPLOY.md.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=reservevision
# `app`: SELECT, INSERT, UPDATE, DELETE only. Used by web, worker and scheduler.
DB_USERNAME=app
DB_PASSWORD=
# `migrator`: all privileges on the schema. Used only by deploy.sh to migrate.
DB_MIGRATOR_USERNAME=migrator
DB_MIGRATOR_PASSWORD=
# MySQL root. Used only by the db container (init) and for backups/restores.
DB_ROOT_PASSWORD=

# --- Sessions, cache, queue -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over HTTPS.
SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Inertia SSR ------------------------------------------------------------
INERTIA_SSR_ENABLED=true
# The ssr service (node bootstrap/ssr/app.js) on the Compose network.
INERTIA_SSR_URL=http://ssr:13714

# --- File storage (MinIO in compose.prod.yaml, or any S3) --------------------
# `s3` for production. Both media disks (config/filesystems.php) use it.
MEDIA_STORAGE=s3
FILESYSTEM_DISK=local
# MinIO admin account. Used only by the minio and minio-setup containers.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# The app's own S3 credentials. minio-setup creates this MinIO user with access
# to the two buckets only. For AWS S3 or another provider, use their keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# MinIO on the Compose network. Leave empty for AWS S3.
AWS_ENDPOINT=http://minio:9000
# true for MinIO (bucket in the path, not the host name).
AWS_USE_PATH_STYLE_ENDPOINT=true
# Public bucket: listing photos.
AWS_PHOTOS_BUCKET=reservevision-photos
# Public base URL of the photos bucket. With MinIO, Caddy serves it at
# https://<DOMAIN>/media/photos (docker/caddy/Caddyfile).
AWS_PHOTOS_URL=
# Private bucket: payment proofs. Never public.
AWS_PROOFS_BUCKET=reservevision-proofs

# --- Mail (any SMTP provider; DEPLOY.md lists some) --------------------------
MAIL_MAILER=smtp
# smtp (STARTTLS, usually port 587) or smtps (implicit TLS, usually port 465).
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# A sender on a domain verified with the provider (SPF and DKIM set up).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ReserveVision
