# Works with `bin/setup` / `docker compose up` as is. Passwords here are for
# local development only; production sets its own (slice 1.3).

# Host ports (127.0.0.1 only). Change these if they clash with something else.
APP_PORT=8180
VITE_PORT=5183
FORWARD_DB_PORT=33306
FORWARD_MAILPIT_DASHBOARD_PORT=8126
FORWARD_MAILPIT_PORT=1126

APP_NAME=ReserveVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:${APP_PORT}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (ADR 0008). The app, workers, scheduler and tests connect as `app`
# (DML only). Migrations run as `migrator` through the `mysql_migrator`
# connection: `composer migrate` or `make migrate`.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=reservevision
DB_TEST_DATABASE=reservevision_test
DB_USERNAME=app
DB_PASSWORD=app-secret
DB_MIGRATOR_USERNAME=migrator
DB_MIGRATOR_PASSWORD=migrator-secret
# Used only by the MySQL container to create the users on first start.
DB_ROOT_PASSWORD=root-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mailpit: inbox at http://localhost:${FORWARD_MAILPIT_DASHBOARD_PORT}
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@reservevision.test"
MAIL_FROM_NAME="${APP_NAME}"

# Inertia SSR. In dev the Vite dev server (`ssr` service) renders pages; the app
# reaches it by service name while the browser uses localhost:${VITE_PORT}.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_HOT_URL=http://ssr:${VITE_PORT}

VITE_APP_NAME="${APP_NAME}"
